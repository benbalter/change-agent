{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "change-agent-test-live",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Live mode: the real Artifacts service instead of the local stand-in.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "change-agent-test", "remote": true }],
  "durable_objects": {
    "bindings": [
      { "name": "CHANGE_AGENT", "class_name": "TestChangeAgentDO" },
      { "name": "BARE_AGENT", "class_name": "ChangeAgentDO" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestChangeAgentDO", "ChangeAgentDO"] }],
}
