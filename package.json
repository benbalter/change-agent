{
  "name": "change-agent",
  "version": "0.0.0",
  "description": "A Git-backed key-value store on Cloudflare Artifacts, for tracking changes to documents and other files over time",
  "keywords": [
    "git",
    "key-value",
    "cloudflare",
    "workers",
    "artifacts",
    "durable-objects",
    "scraper"
  ],
  "homepage": "https://github.com/benbalter/change-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benbalter/change-agent.git"
  },
  "license": "MIT",
  "author": "Ben Balter",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "fix": "eslint --fix . && prettier --write .",
    "test": "vitest run --config vitest.node.config.ts && vitest run",
    "prepare": "npm run build",
    "test:live": "CHANGE_AGENT_LIVE=1 vitest run"
  },
  "dependencies": {
    "isomorphic-git": "1.43.1",
    "memfs": "4.80.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "5.20261007.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "node-git-server": "1.0.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  },
  "allowScripts": {
    "workerd": true,
    "esbuild": true,
    "node-git-server": false,
    "fsevents": false
  },
  "private": true
}
